{
    "name": "brewmail/sdk",
    "description": "Official PHP SDK for the BrewMail API — programmable disposable email for E2E testing",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "BrewMail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BrewMail\\Tests\\": "tests/"
        }
    },
    "keywords": ["email", "api", "disposable-email", "e2e-testing", "otp", "brewmail"]
}
